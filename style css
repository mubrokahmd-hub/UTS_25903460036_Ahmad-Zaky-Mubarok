/* Reset & styling dasar */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #f4f7f6;
    color: #333;
}

/* Header */
.main-header {
    background-color: #1e3a8a;
    color: white;
    text-align: center;
    padding: 25px 20px;
    border-bottom: 4px solid #3b82f6;
}

.main-header h1 {
    font-size: 28px;
    margin-bottom: 5px;
}

/* Navigasi utama */
.main-nav {
    background-color: #1e293b;
    padding: 12px 0;
}

.main-nav ul {
    display: flex;
    justify-content: center;
    gap: 20px;
    list-style: none;
}

.main-nav a {
    color: #e2e8f0;
    text-decoration: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 500;
    transition: background-color 0.3s;
}

.main-nav a:hover,
.main-nav a.active {
    background-color: #3b82f6;
    color: white;
}

/* Kontainer utama dashboard */
.dashboard-container {
    display: flex;
    align-items: flex-start;
    gap: 25px;
    max-width: 1000px;
    margin: 30px auto;
    padding: 0 20px;
}

/* Kartu profil mahasiswa */
.profile-card {
    flex: 1;
    background-color: white;
    padding: 25px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    text-align: center;
}

.avatar {
    font-size: 60px;
    margin-bottom: 15px;
}

.profile-card h2 {
    color: #1e3a8a;
    margin-bottom: 15px;
    padding-bottom: 8px;
    border-bottom: 2px solid #e2e8f0;
    font-size: 20px;
}

.profile-info p {
    margin: 10px 0;
    font-size: 15px;
    text-align: left;
}

/* Kartu statistik akademik */
.stats-container {
    flex: 2;
    background-color: white;
    padding: 25px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
}

.stats-container h2 {
    color: #1e3a8a;
    margin-bottom: 20px;
    padding-bottom: 8px;
    border-bottom: 2px solid #e2e8f0;
    font-size: 20px;
}

.stats-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.stat-card {
    flex: 1 1 calc(50% - 15px);
    background-color: #eff6ff;
    padding: 20px;
    border-left: 5px solid #3b82f6;
    border-radius: 10px;
    text-align: center;
}

.stat-card h3 {
    color: #64748b;
    margin-bottom: 8px;
    font-size: 14px;
}

.stat-value {
    color: #1e3a8a;
    font-size: 26px;
    font-weight: bold;
}

/* Footer */
.main-footer {
    background-color: #1e293b;
    color: #94a3b8;
    text-align: center;
    padding: 15px 20px;
    margin-top: 40px;
    font-size: 14px;
}

/* Tampilan smartphone */
@media (max-width: 768px) {
    .main-nav ul {
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .dashboard-container {
        flex-direction: column;
    }

    .profile-card,
    .stats-container {
        width: 100%;
    }

    .stat-card {
        flex: 1 1 100%;
    }
}
